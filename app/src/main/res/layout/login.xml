<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Password login is currently very experimental and may be unsafe and more prone to account restrictions, use it at your own risk. An alt account is strongly recommended." />

    <EditText
        android:id="@+id/emailField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Email"
        android:inputType="textWebEmailAddress"
        android:maxLines="1"
        android:singleLine="true" />

    <EditText
        android:id="@+id/passwordField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Password"
        android:inputType="textPassword"
        android:password="true"
        android:maxLines="1"
        android:singleLine="true" />

    <TextView
        android:id="@+id/existingPasswordText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Leave blank to use the existing password"
        android:visibility="gone" />

    <Button
        android:id="@+id/loginButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log in" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Token login is recommended but only intended for advanced users." />

    <EditText
        android:id="@+id/tokenField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Token"
        android:inputType="textPassword"
        android:password="true"
        android:maxLines="1"
        android:singleLine="true" />

    <Button
        android:id="@+id/tokenLoginButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Use token" />

</LinearLayout>
