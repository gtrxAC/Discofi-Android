<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ListView
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="2dp"
        android:paddingTop="2dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:stackFromBottom="true" />

    <LinearLayout
        android:id="@+id/reply_panel"
        android:layout_width="fill_parent"
        android:layout_height="46dp"
        android:background="@android:drawable/bottom_bar"
        android:gravity="center_vertical"
        android:padding="5dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/reply_to"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:text="Reply to"
            android:textAppearance="?android:attr/textAppearance" />

        <ToggleButton
            android:id="@+id/ping_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="@ Off"
            android:textOn="@ On"
            style="?android:attr/buttonStyleSmall" />

        <ImageButton
            android:id="@+id/cancel_reply"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_btn_close_panel"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:drawable/bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="5dp">

        <EditText
            android:id="@+id/messageComposer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Message"
            android:inputType="textAutoCorrect|textCapSentences|textMultiLine|textImeMultiLine"
            android:maxLength="2000"
            android:maxLines="4"
            android:nextFocusRight="@+id/msg_send" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send" />
    </LinearLayout>

</LinearLayout>
