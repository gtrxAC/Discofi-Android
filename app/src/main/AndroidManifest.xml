<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fi.gtrxac.discord">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <meta-data
            android:name="fi.gtrxac.discord.DiscofiGlideModule"
            android:value="GlideModule" />

        <activity
            android:name="fi.gtrxac.discord.MainActivity"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="fi.gtrxac.discord.AccountListActivity"
            android:label="@string/accounts"></activity>

        <activity
            android:name="fi.gtrxac.discord.LoginActivity"
            android:label="@string/login"></activity>

        <activity
            android:name="fi.gtrxac.discord.ConnectionModeActivity"
            android:label="@string/connection_setup"></activity>

        <activity
            android:name="fi.gtrxac.discord.MfaActivity"
            android:label="@string/auth_code"></activity>

        <activity
            android:name="fi.gtrxac.discord.ChannelListActivity"
            android:label="@string/app_name"></activity>

        <activity
            android:name="fi.gtrxac.discord.ChatActivity"
            android:label="@string/app_name"
            android:windowSoftInputMode="stateAlwaysHidden"></activity>

        <activity
            android:name="fi.gtrxac.discord.FilePickerActivity"
            android:label="@string/app_name"></activity>

        <activity
            android:name="fi.gtrxac.discord.SettingsActivity"
            android:label="@string/settings"></activity>

    </application>
</manifest>
