<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fi.gtrxac.discord">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true">

        <meta-data
            android:name="fi.gtrxac.discord.DiscofiGlideModule"
            android:value="GlideModule" />

        <activity
            android:label="@string/app_name"
            android:name="fi.gtrxac.discord.MainActivity">
            <intent-filter >
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:label="@string/accounts"
            android:name="fi.gtrxac.discord.AccountListActivity">
        </activity>

        <activity
            android:label="@string/login"
            android:name="fi.gtrxac.discord.LoginActivity">
        </activity>

        <activity
            android:label="@string/connection_setup"
            android:name="fi.gtrxac.discord.ConnectionModeActivity">
        </activity>

        <activity
            android:label="@string/auth_code"
            android:name="fi.gtrxac.discord.MfaActivity">
        </activity>

        <activity
            android:label="@string/app_name"
            android:name="fi.gtrxac.discord.ChannelListActivity">
        </activity>

        <activity
            android:label="@string/app_name"
            android:name="fi.gtrxac.discord.ChatActivity"
            android:windowSoftInputMode="stateAlwaysHidden">
        </activity>

        <activity
            android:label="@string/app_name"
            android:name="fi.gtrxac.discord.FilePickerActivity">
        </activity>

        <activity
            android:label="@string/settings"
            android:name="fi.gtrxac.discord.SettingsActivity">
        </activity>

    </application>
</manifest>
